# Vorlage für die lokale Konfiguration.
# Kopieren und anpassen:  cp .env.example .env
# Die echte .env ist gitignored und gehört NICHT ins Repository.

# Django Secret Key.
# Produktion: zwingend setzen. Lokal optional – ohne Wert wird automatisch
# einer in .secret_key erzeugt. Neuen Key generieren:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Debug-Modus: lokal True, Produktion False.
DJANGO_DEBUG=True

# Kommagetrennte erlaubte Hosts, z. B. example.com,www.example.com
# Bei DEBUG=True optional (Default: localhost,127.0.0.1).
DJANGO_ALLOWED_HOSTS=
